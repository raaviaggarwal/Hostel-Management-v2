    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "prisma": "^6.16.0",
    "supertest": "^7.1.1",
    "vitest": "^4.1.10"
